# =====================================================================
# Green Guardian: GCP & Model Configuration
# =====================================================================

# Google Cloud Platform Project Details
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Google Cloud Storage Bucket for Legal PDFs
GCS_BUCKET_NAME=green-guardian-docs-your-project-id

# Vertex AI Agent Builder / Discovery Engine (Optional for GCP-Managed Search)
DATA_STORE_ID=green-guardian-data-store
DATA_STORE_LOCATION=global

# Default Gemini Models
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-1.5-pro

# Fallback / Local Development (Optional Google AI Studio API Key for offline/local testing)
GEMINI_API_KEY=
